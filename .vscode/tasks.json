{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run C++ in Terminal",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "& { $out = Join-Path '${workspaceFolder}' 'build'; if (!(Test-Path $out)) { New-Item -ItemType Directory -Path $out | Out-Null }; $exe = Join-Path $out '${fileBasenameNoExtension}.exe'; & 'C:\\msys64\\ucrt64\\bin\\g++.exe' '${file}' -o $exe; if ($LASTEXITCODE -eq 0) { & $exe } }"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true,
                "clear": false
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}